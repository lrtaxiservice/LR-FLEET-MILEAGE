# Copy this file to .env and fill in the values. Never commit .env.

# Database. Local (npm run db:start) uses the value below.
# On Railway use the Supabase "Session pooler" connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/lrfleet
# Used only for migrations. Locally the same as DATABASE_URL; on Supabase the Session pooler (port 5432) string.
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/lrfleet

# A long random text used to sign login cookies (at least 32 characters).
SESSION_SECRET=change-me-to-a-long-random-text-at-least-32-chars

# The one and only Admin, created by `npm run seed` if no Admin exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Port for the web server (Railway sets this itself).
PORT=3000

# Document scans (Phase 3). Leave blank locally to use the uploads/ folder.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=vehicle-documents

# Password for the demo users created by npm run demo (local only).
DEMO_PASSWORD=change-me-demo
